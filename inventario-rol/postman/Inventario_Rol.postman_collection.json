{
  "info": {
    "name": "Inventario Rol y Coleccionables API",
    "description": "Coleccion de pruebas REST para la entidad Producto con arquitectura en capas",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Listar todos los productos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/productos",
          "host": ["{{baseUrl}}"],
          "path": ["productos"]
        }
      }
    },
    {
      "name": "2. Crear Producto - Manual D&D 5e",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigoSku\": \"ROL-DD5-001\",\n  \"nombre\": \"Manual del Jugador D&D 5ta Edicion\",\n  \"descripcion\": \"Libro basico de reglas oficiales en tapa dura para jugadores\",\n  \"categoria\": \"MANUAL_ROL\",\n  \"precio\": 189900.00,\n  \"stock\": 15\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/productos",
          "host": ["{{baseUrl}}"],
          "path": ["productos"]
        }
      }
    },
    {
      "name": "3. Crear Producto - Set de Dados Metalicos",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigoSku\": \"DAD-MET-002\",\n  \"nombre\": \"Set de Dados Poliedricos Metalicos Dragon\",\n  \"descripcion\": \"Juego de 7 dados metalicos de alta densidad con estuche de lata\",\n  \"categoria\": \"SET_DADOS\",\n  \"precio\": 95000.00,\n  \"stock\": 30\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/productos",
          "host": ["{{baseUrl}}"],
          "path": ["productos"]
        }
      }
    },
    {
      "name": "4. Obtener Producto por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/productos/1",
          "host": ["{{baseUrl}}"],
          "path": ["productos", "1"]
        }
      }
    },
    {
      "name": "5. Obtener Producto por SKU",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/productos/sku/ROL-DD5-001",
          "host": ["{{baseUrl}}"],
          "path": ["productos", "sku", "ROL-DD5-001"]
        }
      }
    },
    {
      "name": "6. Filtrar por Categoria",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/productos/categoria/MANUAL_ROL",
          "host": ["{{baseUrl}}"],
          "path": ["productos", "categoria", "MANUAL_ROL"]
        }
      }
    },
    {
      "name": "7. Actualizar Producto",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigoSku\": \"ROL-DD5-001\",\n  \"nombre\": \"Manual del Jugador D&D 5ta Edicion (Revisado)\",\n  \"descripcion\": \"Libro basico de reglas oficiales en tapa dura - Edicion especial\",\n  \"categoria\": \"MANUAL_ROL\",\n  \"precio\": 199900.00,\n  \"stock\": 12\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/productos",
          "host": ["{{baseUrl}}"],
          "path": ["productos", "1"]
        }
      }
    },
    {
      "name": "8. Eliminar Producto",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/productos/1",
          "host": ["{{baseUrl}}"],
          "path": ["productos", "1"]
        }
      }
    }
  ]
}
